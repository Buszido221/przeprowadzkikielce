---
import '../styles/base.css';
import '../styles/sales-landing.css';
import Analytics from '../components/Analytics.astro';
import GoogleTagHead from '../components/GoogleTagHead.astro';
import CampaignAttribution from '../components/CampaignAttribution.astro';
import LandingLeadForm from '../components/LandingLeadForm.astro';
import { site } from '../data/site';
import { testimonials } from '../data/home';
import { isStaging } from '../lib/environment';
import type { LandingPageData } from '../data/landingPages';

export interface Props {
  page: LandingPageData;
}

const { page } = Astro.props;
const isActive = page.campaignEnabled;

const heroFormId = `lp-form-hero-${page.slug}`;

const pageRobots = page.robots ?? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const robotsContent = isStaging ? 'noindex, nofollow, noarchive' : pageRobots;
const ogImageUrl = `${site.domain}${page.hero.image.replace(/^\//, '')}`;

const breadcrumbItems = page.breadcrumbs ?? [
  { name: 'Strona główna', url: site.domain },
  { name: 'Landing page', url: page.seo.canonical },
];

const galleryImages = page.gallery.images.slice(0, 4);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.seo.title.split('|')[0].trim(),
  description: page.seo.description,
  provider: {
    '@type': 'LocalBusiness',
    name: site.brand,
    telephone: site.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.city,
      postalCode: site.address.postalCode,
      addressCountry: 'PL',
    },
  },
  areaServed: { '@type': 'State', name: 'województwo świętokrzyskie' },
  url: page.seo.canonical,
  serviceType: page.formServiceType,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: item.url,
  })),
};

const faqSchema = page.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={robotsContent} />
    <meta name="description" content={page.seo.description} />
    <link rel="icon" type="image/svg+xml" href="/images/LOGO_WHM.svg" />
    <link rel="canonical" href={page.seo.canonical} />
    <title>{page.seo.title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={page.seo.title} />
    <meta property="og:description" content={page.seo.description} />
    <meta property="og:url" content={page.seo.canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={page.hero.imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.seo.title} />
    <meta name="twitter:description" content={page.seo.description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

    <GoogleTagHead />
    <CampaignAttribution />
  </head>
  <body class="lp-body">
    <a href="#main-content" class="skip-link">Przejdź do treści</a>

    <!-- HEADER -->
    <header class="lp-header" data-lp-header>
      <div class="container lp-header__inner">
        <a href="/" class="lp-header__brand" aria-label="WHM Przeprowadzki - strona główna">
          <img src="/images/LOGO_WHM.svg" alt="WHM Przeprowadzki" width="120" height="32" />
        </a>
        <div class="lp-header__actions">
          <a href={`tel:${site.phoneRaw}`} class="lp-header__phone" data-phone-click>
            <svg class="lp-header__phone-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
            <span class="lp-header__phone-text">{site.phone}</span>
          </a>
          {isActive && (
            <a href="#wycena" class="btn btn--primary btn--sm lp-header__cta" data-cta-click data-cta-location="header">Wyceń</a>
          )}
        </div>
      </div>
    </header>

    <main id="main-content">
      {isActive ? (
        <>
          <!-- HERO -->
          <section class="lp-hero">
            <div class="container lp-hero__container">
              <div class="lp-hero__left">
                <span class="lp-hero__eyebrow">{page.hero.eyebrow}</span>
                <h1 class="lp-hero__heading">{page.hero.heading}</h1>
                <p class="lp-hero__lead">{page.hero.lead}</p>
                <ul class="lp-hero__proof">
                  {page.hero.proofPoints.map((point) => (
                    <li class="lp-hero__proof-item">
                      <svg class="lp-hero__proof-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
                <div class="lp-hero__cta-row">
                  <a href="#wycena" class="btn btn--primary btn--lg" data-cta-click data-cta-location="hero">{page.hero.primaryCta}</a>
                  <a href={`tel:${site.phoneRaw}`} class="btn btn--ghost btn--lg" data-phone-click>{page.hero.secondaryCta}</a>
                </div>
              </div>
              <div class="lp-hero__right" id="wycena">
                <span id="formularz" class="lp-anchor-offset" aria-hidden="true"></span>
                <div class="lp-hero__form-wrap">
                  <LandingLeadForm formId={heroFormId} serviceType={page.formServiceType} variant={page.formVariant} placeholder={page.formPlaceholder} submitLabel={page.formSubmitLabel} />
                </div>
                <img src={page.hero.image} alt={page.hero.imageAlt} width="640" height="360" class="lp-hero__img" fetchpriority="high" decoding="async" loading="eager" />
              </div>
            </div>
          </section>

          <!-- TRUST STRIP -->
          {page.trustStrip.length > 0 && (
            <section class="lp-trust">
              <div class="container">
                <ul class="lp-trust__list">
                  {page.trustStrip.map((item) => (
                    <li class="lp-trust__item">
                      <svg class="lp-trust__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          )}

          <!-- BENEFITS -->
          {page.benefits.items.length > 0 && (
            <section class="section section--alt lp-benefits lp-anchor-section" id="zakres">
              <div class="container">
                <div class="section-heading">
                  <h2 class="section-heading__title">{page.benefits.heading}</h2>
                </div>
                <div class="lp-benefits__grid">
                  {page.benefits.items.map((item) => (
                    <div class="lp-benefits__card">
                      <h3 class="lp-benefits__card-title">{item.title}</h3>
                      <p class="lp-benefits__card-desc">{item.desc}</p>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          )}

          <!-- FACTORS (only for cena page) -->
          {page.factors && page.factors.items.length > 0 && (
            <section class="section lp-factors">
              <div class="container">
                <div class="section-heading">
                  <h2 class="section-heading__title">{page.factors.heading}</h2>
                </div>
                <ul class="lp-factors__list">
                  {page.factors.items.map((item) => (
                    <li class="lp-factors__item">
                      <svg class="lp-factors__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          )}

          <!-- WHAT WE ASSESS -->
          {page.whatWeAssess && page.whatWeAssess.items.length > 0 && (
            <section class="section section--alt lp-assess">
              <div class="container">
                <div class="section-heading">
                  <h2 class="section-heading__title">{page.whatWeAssess.heading}</h2>
                </div>
                <ul class="lp-assess__list">
                  {page.whatWeAssess.items.map((item) => (
                    <li class="lp-assess__item">{item}</li>
                  ))}
                </ul>
              </div>
            </section>
          )}

          <!-- ITEMS LIST -->
          {page.itemsList && page.itemsList.items.length > 0 && (
            <section class="section lp-items">
              <div class="container">
                <div class="section-heading">
                  <h2 class="section-heading__title">{page.itemsList.heading}</h2>
                </div>
                <ul class="lp-items__list">
                  {page.itemsList.items.map((item) => (
                    <li class="lp-items__item">{item}</li>
                  ))}
                </ul>
              </div>
            </section>
          )}

          <!-- SERVICE VARIANTS (utylizacja) -->
          {page.serviceVariants && page.serviceVariants.items.length > 0 && (
            <section class="section section--alt lp-variants">
              <div class="container">
                <div class="section-heading">
                  <h2 class="section-heading__title">{page.serviceVariants.heading}</h2>
                </div>
                <div class="lp-benefits__grid">
                  {page.serviceVariants.items.map((item) => (
                    <div class="lp-benefits__card">
                      <h3 class="lp-benefits__card-title">{item.title}</h3>
                      <p class="lp-benefits__card-desc">{item.desc}</p>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          )}

          <!-- EXCLUSIONS (utylizacja) -->
          {page.exclusions && page.exclusions.items.length > 0 && (
            <section class="section lp-exclusions">
              <div class="container">
                <div class="section-heading">
                  <h2 class="section-heading__title">{page.exclusions.heading}</h2>
                </div>
                <ul class="lp-exclusions__list">
                  {page.exclusions.items.map((item) => (
                    <li class="lp-exclusions__item">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
                {page.exclusions.text && <p class="lp-exclusions__text">{page.exclusions.text}</p>}
              </div>
            </section>
          )}

          <!-- PSZOK / LEGAL DISPOSAL (utylizacja) -->
          {page.pszok && (
            <section class="section section--alt lp-pszok">
              <div class="container">
                <div class="section-heading">
                  <h2 class="section-heading__title">{page.pszok.heading}</h2>
                </div>
                <p class="lp-problem__text">{page.pszok.text}</p>
              </div>
            </section>
          )}

          <!-- GALLERY -->
          {galleryImages.length > 0 && (
            <section class="section section--alt lp-gallery lp-anchor-section" id="realizacje">
              <div class="container">
                <div class="section-heading">
                  <h2 class="section-heading__title">{page.gallery.heading}</h2>
                </div>
                <div class="lp-gallery__scroll">
                  {galleryImages.map((img) => (
                    <figure class="lp-gallery__item">
                      <img src={img.src} alt={img.alt} width="480" height="320" class="lp-gallery__img" loading="lazy" decoding="async" />
                    </figure>
                  ))}
                </div>
              </div>
            </section>
          )}

          <!-- SCOPE -->
          {page.scope && page.scope.items.length > 0 && (
            <section class="section lp-scope">
              <div class="container">
                <div class="section-heading">
                  <h2 class="section-heading__title">{page.scope.heading}</h2>
                </div>
                <ul class="lp-scope__list">
                  {page.scope.items.map((item) => (
                    <li class="lp-scope__item">
                      <svg class="lp-scope__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
                {page.scope.footnote && <p class="lp-scope__footnote">{page.scope.footnote}</p>}
              </div>
            </section>
          )}

          <!-- PROCESS -->
          {page.process.steps.length > 0 && (
            <section class="section section--alt lp-process lp-anchor-section" id="jak-to-dziala">
              <div class="container">
                <div class="section-heading">
                  <h2 class="section-heading__title">{page.process.heading}</h2>
                </div>
                <div class="lp-process__steps">
                  {page.process.steps.map((step, i) => (
                    <div class="lp-process__step">
                      <span class="lp-process__num">{String(i + 1).padStart(2, '0')}</span>
                      <h3 class="lp-process__step-title">{step.title}</h3>
                      <p class="lp-process__step-desc">{step.desc}</p>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          )}

          <!-- TESTIMONIALS -->
          {page.testimonials.length > 0 && (
            <section class="section lp-testimonials lp-anchor-section" id="opinie">
              <div class="container">
                <div class="section-heading">
                  <h2 class="section-heading__title">Opinie klientów</h2>
                </div>
                <div class="lp-testimonials__grid">
                  {page.testimonials.map((idx) => testimonials[idx]).filter(Boolean).map((t) => (
                    <figure class="lp-testimonials__card">
                      <blockquote class="lp-testimonials__text">"{t.text}"</blockquote>
                      <figcaption class="lp-testimonials__author">- {t.author}{t.source ? `, ${t.source}` : ''}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            </section>
          )}

          <!-- FAQ -->
          {page.faq.length > 0 && (
            <section class="section section--alt lp-faq lp-anchor-section" id="faq">
              <div class="container">
                <div class="section-heading">
                  <h2 class="section-heading__title">Najczęstsze pytania</h2>
                </div>
                <div class="lp-faq__list">
                  {page.faq.map((item) => (
                    <details class="lp-faq__item">
                      <summary class="lp-faq__question">{item.question}</summary>
                      <div class="lp-faq__answer">
                        <p>{item.answer}</p>
                      </div>
                    </details>
                  ))}
                </div>
              </div>
            </section>
          )}

          <!-- RELATED SERVICES -->
          {page.relatedServices && page.relatedServices.length > 0 && (
            <section class="section lp-related">
              <div class="container">
                <div class="section-heading">
                  <h2 class="section-heading__title">Powiązane usługi</h2>
                </div>
                <div class="lp-related__links">
                  {page.relatedServices.map((link) => (
                    <a href={link.href} class="lp-related__link">
                      <span>{link.label}</span>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                      </svg>
                    </a>
                  ))}
                </div>
              </div>
            </section>
          )}

          <!-- FINAL CTA (no second form) -->
          <section class="section lp-final-cta">
            <div class="container lp-final-cta__container">
              <h2 class="lp-final-cta__heading">{page.finalCta.heading}</h2>
              <p class="lp-final-cta__text">{page.finalCta.text}</p>
              <div class="lp-final-cta__actions">
                <a href="#wycena" class="btn btn--primary btn--lg" data-cta-click data-cta-location="final">Zostaw numer telefonu</a>
                <a href={`tel:${site.phoneRaw}`} class="btn btn--ghost btn--lg" data-phone-click>Zadzwoń: {site.phone}</a>
              </div>
            </div>
          </section>
        </>
      ) : (
        <!-- INACTIVE PAGE -->
        <section class="section lp-inactive">
          <div class="container lp-inactive__container">
            <h1 class="lp-inactive__heading">{page.hero.heading}</h1>
            <p class="lp-inactive__lead">{page.hero.lead}</p>
            <div class="lp-inactive__actions">
              <a href={`tel:${site.phoneRaw}`} class="btn btn--primary btn--lg" data-phone-click>Zadzwoń: {site.phone}</a>
              <a href="/" class="btn btn--ghost btn--lg">Strona główna</a>
            </div>
          </div>
        </section>
      )}
    </main>

    <!-- FOOTER -->
    <footer class="lp-footer">
      <div class="container">
        <div class="lp-footer__inner">
          <p class="lp-footer__company">{site.legalName} &middot; NIP: {site.nip}</p>
          <p class="lp-footer__address">Adres operacyjny: {site.address.full}</p>
          <p class="lp-footer__contact">
            <a href={`tel:${site.phoneRaw}`}>{site.phone}</a> &middot;
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
          <p class="lp-footer__links">
            <a href="/polityka-prywatnosci/">Polityka prywatności</a>
          </p>
        </div>
      </div>
    </footer>

    {isActive && (
      <div class="lp-sticky-cta">
        <a href={`tel:${site.phoneRaw}`} class="lp-sticky-cta__btn lp-sticky-cta__btn--phone" data-phone-click>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          Zadzwoń
        </a>
        <a href="#wycena" class="lp-sticky-cta__btn lp-sticky-cta__btn--form" data-cta-click data-cta-location="sticky">
          Wyceń
        </a>
      </div>
    )}

    {isStaging ? null : <Analytics />}

    {isActive && (
      <script>
        // Sticky header
        const header = document.querySelector('[data-lp-header]');
        if (header) {
          window.addEventListener('scroll', () => {
            header.classList.toggle('is-scrolled', window.pageYOffset > 40);
          }, { passive: true });
        }

        // CTA click dispatch (local event only — Analytics.astro maps to GA4 on production)
        document.addEventListener('click', (e) => {
          const el = (e.target as HTMLElement).closest('[data-cta-click]');
          if (!el) return;
          const loc = (el as HTMLElement).dataset.ctaLocation || 'unknown';
          document.dispatchEvent(new CustomEvent('whm:analytics', {
            detail: { event: 'cta_click', cta_location: loc, page_path: location.pathname }
          }));
        });
      </script>
    )}
  </body>
</html>
