---
import Layout from '../../layouts/Layout.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
import { site } from '../../data/site';
import { wycenaPage as page } from '../../data/services';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: site.domain },
        { '@type': 'ListItem', position: 2, name: 'Wycena', item: page.seo.canonical },
      ],
    },
  ],
};
---

<Layout title={page.seo.title} description={page.seo.description} robots="noindex, follow">
  <link slot="head" rel="canonical" href={page.seo.canonical} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <SubpageHero
    heading={page.hero.heading}
    lead={page.hero.lead}
    breadcrumbs={page.breadcrumbs}
  />

  <section class="section">
    <div class="container">
      <div class="split-section">
        <div class="split-section__content">
          <SectionHeading label="Formularz wyceny" title="Opowiedz nam, czego potrzebujesz" />

          <LeadForm
            formId="quote-form"
            serviceType="Wycena - formularz kontaktowy"
            presentation="page"
            context="consumer"
            formLocation="wycena-page"
            submitLabel="Wyślij zapytanie"
          />
        </div>

        <div class="split-section__media">
          <SectionHeading label="Alternatywy" title="Możesz też skontaktować się bezpośrednio" />
          <div class="contact-card">
            <div class="contact-card__row">
              <span class="contact-card__label">Telefon / SMS</span>
              <span class="contact-card__value"><a href={`tel:${site.phoneRaw}`}>{site.phone}</a></span>
            </div>
            <div class="contact-card__row">
              <span class="contact-card__label">E-mail</span>
              <span class="contact-card__value"><a href={`mailto:${site.email}`}>{site.email}</a></span>
            </div>
            <div class="contact-card__row">
              <span class="contact-card__label">Godziny kontaktu</span>
              <span class="contact-card__value">Pn–Pt: {site.hours.weekdays}<br />Sob: {site.hours.saturday}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
