---
import Layout from '../../layouts/Layout.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { site } from '../../data/site';
import { standardPage as page } from '../../data/services';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: site.domain },
        { '@type': 'ListItem', position: 2, name: 'Standard WHM', item: page.seo.canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: page.faq.map((q) => ({
        '@type': 'Question',
        name: q.question,
        acceptedAnswer: { '@type': 'Answer', text: q.answer },
      })),
    },
  ],
};
---

<Layout title={page.seo.title} description={page.seo.description} robots="index, follow">
  <link slot="head" rel="canonical" href={page.seo.canonical} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <SubpageHero
    heading={page.hero.heading}
    lead={page.hero.lead}
    breadcrumbs={page.breadcrumbs}
    ctaLabel={page.hero.ctaLabel}
    heroImage={page.hero.image}
  />

  <!-- ARRANGEMENTS -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading label={page.arrangements.eyebrow} title={page.arrangements.heading} />
      <ul class="simple-list">
        {page.arrangements.items.map((item) => (
          <li class="simple-list__item">{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PROTECTION -->
  <section class="section">
    <div class="container">
      <div class="split-section">
        <div class="split-section__content">
          <SectionHeading label={page.protection.eyebrow} title={page.protection.heading} description={page.protection.text} />
        </div>
        <div class="split-section__media">
          <img src={page.protection.image} alt={page.protection.imageAlt} width="800" height="600" loading="lazy" decoding="async" class="section-img" />
        </div>
      </div>
    </div>
  </section>

  <!-- DISASSEMBLY -->
  <section class="section section--alt">
    <div class="container">
      <div class="split-section split-section--reverse">
        <div class="split-section__content">
          <SectionHeading label={page.disassembly.eyebrow} title={page.disassembly.heading} description={page.disassembly.text} />
        </div>
        <div class="split-section__media">
          <img src={page.disassembly.image} alt={page.disassembly.imageAlt} width="800" height="600" loading="lazy" decoding="async" class="section-img" />
        </div>
      </div>
    </div>
  </section>

  <!-- EQUIPMENT -->
  <section class="section">
    <div class="container">
      <div class="split-section">
        <div class="split-section__content">
          <SectionHeading label={page.equipment.eyebrow} title={page.equipment.heading} description={page.equipment.text} />
        </div>
        <div class="split-section__media">
          <img src={page.equipment.image} alt={page.equipment.imageAlt} width="800" height="600" loading="lazy" decoding="async" class="section-img" />
        </div>
      </div>
    </div>
  </section>

  <!-- PACKING -->
  <section class="section section--alt">
    <div class="container">
      <div class="split-section split-section--reverse">
        <div class="split-section__content">
          <SectionHeading label={page.packing.eyebrow} title={page.packing.heading} />
          <ul class="simple-list">
            {page.packing.items.map((item) => (
              <li class="simple-list__item">{item}</li>
            ))}
          </ul>
        </div>
        <div class="split-section__media">
          <img src={page.packing.image} alt={page.packing.imageAlt} width="800" height="600" loading="lazy" decoding="async" class="section-img" />
        </div>
      </div>
    </div>
  </section>

  <!-- STABILIZATION -->
  <section class="section">
    <div class="container">
      <div class="info-block">
        <SectionHeading label={page.stabilization.eyebrow} title={page.stabilization.heading} />
        <p class="info-block__text">{page.stabilization.text}</p>
      </div>
    </div>
  </section>

  <!-- FOR WHOM -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading label={page.forWhom.eyebrow} title={page.forWhom.heading} />
      <div class="standard-links">
        {page.forWhom.items.map((item) => (
          <a href={item.href} class="arrow-link">{item.label}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- NOT PROMISED -->
  <section class="section">
    <div class="container">
      <SectionHeading label={page.notPromised.eyebrow} title={page.notPromised.heading} />
      <ul class="simple-list">
        {page.notPromised.items.map((item) => (
          <li class="simple-list__item">{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading label="Najczęstsze pytania" title="Odpowiedzi na pytania o Standard WHM" />
      <div class="faq-list">
        {page.faq.map((item) => (
          <details class="faq-item">
            <summary class="faq-item__question">{item.question}</summary>
            <div class="faq-item__answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta">
    <div class="container">
      <div class="final-cta__inner">
        <h2 class="final-cta__heading">{page.finalCta.heading}</h2>
        <p class="final-cta__text">{page.finalCta.text}</p>
        <div class="final-cta__actions">
          <a href="/kontakt/#formularz" class="btn btn--primary btn--lg">Poproś o wycenę</a>
          <a href={`tel:${site.phoneRaw}`} class="btn btn--secondary btn--lg">Zadzwoń: 720 719 022</a>
        </div>
        <p class="final-cta__hours">Pn–Pt: {site.hours.weekdays} &middot; Sob: {site.hours.saturday}</p>
      </div>
    </div>
  </section>
</Layout>
