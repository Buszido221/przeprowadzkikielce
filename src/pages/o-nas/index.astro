---
import Layout from '../../layouts/Layout.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { site } from '../../data/site';
import { oNasPage as page } from '../../data/services';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: site.domain },
        { '@type': 'ListItem', position: 2, name: 'O nas', item: page.seo.canonical },
      ],
    },
    {
      '@type': 'AboutPage',
      name: page.seo.title,
      description: page.seo.description,
      mainEntity: {
        '@type': 'LocalBusiness',
        name: 'WHM TRANSPORT MATEUSZ KONDERA',
        telephone: page.companyData.phone,
        email: page.companyData.email,
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Lotnicza 60A',
          addressLocality: 'Masłów Pierwszy',
          postalCode: '26-001',
          addressCountry: 'PL',
        },
      },
    },
  ],
};
---

<Layout title={page.seo.title} description={page.seo.description} robots="index, follow" canonical={page.seo.canonical} ogImage={page.hero.image}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <SubpageHero
    heading={page.hero.heading}
    lead={page.hero.lead}
    breadcrumbs={page.breadcrumbs}
    heroImage={page.hero.image}
  />

  <section class="section section--alt">
    <div class="container">
      <SectionHeading label={page.development.eyebrow} title={page.development.heading} description={page.development.text} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading label={page.standard.eyebrow} title={page.standard.heading} description={page.standard.text} />
      <div class="section-cta">
        <a href={page.standard.link.href} class="arrow-link">{page.standard.link.label}</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <SectionHeading label={page.ecosystem.eyebrow} title={page.ecosystem.heading} />
      <div class="about-ecosystem-grid">
        {page.ecosystem.items.map((item) => (
          <a href={item.href} class="about-ecosystem-card">
            <p class="about-ecosystem-card__title">{item.title}</p>
            <p class="about-ecosystem-card__desc">{item.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split-section">
        <div class="split-section__content">
          <SectionHeading label={page.local.eyebrow} title={page.local.heading} description={page.local.text} />
        </div>
        <div class="split-section__media">
          <img src={page.local.image} alt={page.local.imageAlt} width="800" height="600" loading="lazy" decoding="async" class="section-img" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <SectionHeading label={page.companyData.eyebrow} title={page.companyData.heading} />
      <div class="company-data">
        <div class="company-data__row">
          <span class="company-data__label">Nazwa prawna</span>
          <span class="company-data__value">{page.companyData.heading}</span>
        </div>
        <div class="company-data__row">
          <span class="company-data__label">NIP</span>
          <span class="company-data__value">{page.companyData.nip}</span>
        </div>
        <div class="company-data__row">
          <span class="company-data__label">Adres operacyjny</span>
          <span class="company-data__value">{page.companyData.operationalAddress}</span>
        </div>
        <div class="company-data__row">
          <span class="company-data__label">Adres rejestrowy</span>
          <span class="company-data__value">{page.companyData.registeredAddress}</span>
        </div>
        <div class="company-data__row">
          <span class="company-data__label">Telefon</span>
          <span class="company-data__value"><a href={`tel:${site.phoneRaw}`}>{page.companyData.phone}</a></span>
        </div>
        <div class="company-data__row">
          <span class="company-data__label">E-mail</span>
          <span class="company-data__value"><a href={`mailto:${page.companyData.email}`}>{page.companyData.email}</a></span>
        </div>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container">
      <div class="final-cta__inner">
        <h2 class="final-cta__heading">Porozmawiajmy o Twojej przeprowadzce</h2>
        <p class="final-cta__text">Skontaktuj się lub opisz zlecenie - ustalimy zakres i sposób realizacji.</p>
        <div class="final-cta__actions">
          <a href={`tel:${site.phoneRaw}`} class="btn btn--primary btn--lg" data-cta-click data-cta-location="about-final">Zadzwoń: {site.phone}</a>
          <a href="/wycena/" class="btn btn--secondary btn--lg" data-cta-click data-cta-location="about-final">Poproś o wycenę</a>
        </div>
        <p class="final-cta__hours">Pn–Pt: {site.hours.weekdays} &middot; Sob: {site.hours.saturday}</p>
      </div>
    </div>
  </section>
</Layout>
