---
import Layout from '../../layouts/Layout.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { site } from '../../data/site';
import { kontaktPage as page } from '../../data/services';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: site.domain },
        { '@type': 'ListItem', position: 2, name: 'Kontakt', item: page.seo.canonical },
      ],
    },
    {
      '@type': 'ContactPage',
      name: page.seo.title,
      description: page.seo.description,
      mainEntity: {
        '@type': 'LocalBusiness',
        name: 'WHM TRANSPORT MATEUSZ KONDERA',
        telephone: page.contact.phone,
        email: page.contact.email,
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Lotnicza 60A',
          addressLocality: 'Masłów Pierwszy',
          postalCode: '26-001',
          addressCountry: 'PL',
        },
      },
    },
  ],
};
---

<Layout title={page.seo.title} description={page.seo.description} robots="index, follow">
  <link slot="head" rel="canonical" href={page.seo.canonical} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <SubpageHero
    heading={page.hero.heading}
    lead={page.hero.lead}
    breadcrumbs={page.breadcrumbs}
  />

  <section class="section section--alt">
    <div class="container">
      <SectionHeading label="Dane kontaktowe" title="Skontaktuj się z WHM" />
      <div class="contact-grid">
        <div class="contact-card">
          <p class="contact-card__title">Telefon i SMS</p>
          <div class="contact-card__row">
            <span class="contact-card__label">Telefon</span>
            <span class="contact-card__value"><a href={`tel:${page.contact.phoneRaw}`}>{page.contact.phone}</a></span>
          </div>
          <div class="contact-card__row">
            <span class="contact-card__label">SMS</span>
            <span class="contact-card__value"><a href={`sms:${page.contact.phoneRaw}`}>{page.contact.phone}</a></span>
          </div>
          <div class="contact-card__row">
            <span class="contact-card__label">Godziny kontaktu</span>
            <span class="contact-card__value">Pn–Pt: {page.contact.hoursWeekdays}<br />Sob: {page.contact.hoursSaturday}</span>
          </div>
        </div>

        <div class="contact-card">
          <p class="contact-card__title">E-mail</p>
          <div class="contact-card__row">
            <span class="contact-card__label">Adres e-mail</span>
            <span class="contact-card__value"><a href={`mailto:${page.contact.email}`}>{page.contact.email}</a></span>
          </div>
        </div>

        <div class="contact-card">
          <p class="contact-card__title">Adres operacyjny</p>
          <div class="contact-card__row">
            <span class="contact-card__label">Adres</span>
            <span class="contact-card__value">{page.contact.operationalAddress}</span>
          </div>
          <div class="contact-card__row">
            <span class="contact-card__label">Wskazówki dojazdu</span>
            <span class="contact-card__value"><a href={page.contact.directionsUrl} target="_blank" rel="noopener noreferrer">Zobacz na mapie</a></span>
          </div>
          <p class="contact-card__note">{page.contact.visitNote}</p>
        </div>

        <div class="contact-card">
          <p class="contact-card__title">Adres rejestrowy</p>
          <div class="contact-card__row">
            <span class="contact-card__label">Adres</span>
            <span class="contact-card__value">{page.contact.registeredAddress}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container">
      <div class="final-cta__inner">
        <h2 class="final-cta__heading">Wolisz opisać zlecenie?</h2>
        <p class="final-cta__text">Skorzystaj z formularza wyceny - prześlij lokalizacje, zakres i warunki dostępu.</p>
        <div class="final-cta__actions">
          <a href="/wycena/" class="btn btn--primary btn--lg">Przejdź do wyceny</a>
          <a href={`tel:${site.phoneRaw}`} class="btn btn--secondary btn--lg">Zadzwoń: 720 719 022</a>
        </div>
        <p class="final-cta__hours">Pn–Pt: {site.hours.weekdays} &middot; Sob: {site.hours.saturday}</p>
      </div>
    </div>
  </section>
</Layout>
