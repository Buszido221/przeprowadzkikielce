---
import Layout from '../../layouts/Layout.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SafeImage from '../../components/SafeImage.astro';
import { site } from '../../data/site';
import { jakToDzialaPage as page } from '../../data/services';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: site.domain },
        { '@type': 'ListItem', position: 2, name: 'Jak to działa', item: page.seo.canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: page.faq.map((q) => ({
        '@type': 'Question',
        name: q.question,
        acceptedAnswer: { '@type': 'Answer', text: q.answer },
      })),
    },
  ],
};
---

<Layout title={page.seo.title} description={page.seo.description} robots="index, follow">
  <link slot="head" rel="canonical" href={page.seo.canonical} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <SubpageHero
    heading={page.hero.heading}
    lead={page.hero.lead}
    breadcrumbs={page.breadcrumbs}
    heroImage={page.hero.image}
  />

  <section class="section section--alt">
    <div class="container">
      <SectionHeading label="Proces współpracy" title="Sześć etapów od kontaktu do zakończenia" />
      <div class="process-steps process-steps--6">
        {page.process.map((step) => (
          <div class="process-step">
            <span class="process-step__number">{step.number}</span>
            <div>
              <p class="process-step__title">{step.title}</p>
              <p class="process-step__desc">{step.desc}</p>
              {step.image && (
                <div class="process-step__image" style="margin-top: var(--space-4); border-radius: var(--radius-lg); overflow: hidden;">
                  <SafeImage src={step.image} alt={step.imageAlt} loading="lazy" decoding="async" />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading label={page.checklist.eyebrow} title={page.checklist.heading} />
      <ul class="simple-list">
        {page.checklist.items.map((item) => (
          <li class="simple-list__item">{item}</li>
        ))}
      </ul>
      <div class="section-cta">
        <a href="/kontakt/#formularz" class="btn btn--primary">Przejdź do wyceny</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <SectionHeading label="Najczęstsze pytania" title="Odpowiedzi na pytania o proces współpracy" />
      <div class="faq-list">
        {page.faq.map((item) => (
          <details class="faq-item">
            <summary class="faq-item__question">{item.question}</summary>
            <div class="faq-item__answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container">
      <div class="final-cta__inner">
        <h2 class="final-cta__heading">Gotowy, żeby zacząć od właściwych informacji?</h2>
        <p class="final-cta__text">Opisz zlecenie, a my ustalimy zakres, sprzęt i sposób realizacji.</p>
        <div class="final-cta__actions">
          <a href="/kontakt/#formularz" class="btn btn--primary btn--lg">Poproś o wycenę</a>
          <a href={`tel:${site.phoneRaw}`} class="btn btn--secondary btn--lg">Zadzwoń: 720 719 022</a>
        </div>
        <p class="final-cta__hours">Pn–Pt: {site.hours.weekdays} &middot; Sob: {site.hours.saturday}</p>
      </div>
    </div>
  </section>
</Layout>
