---
import Layout from '../../layouts/Layout.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { site } from '../../data/site';
import { poradnikPage as page } from '../../data/services';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: site.domain },
        { '@type': 'ListItem', position: 2, name: 'Poradnik', item: page.seo.canonical },
      ],
    },
  ],
};
---

<Layout title={page.seo.title} description={page.seo.description} robots="index, follow">
  <link slot="head" rel="canonical" href={page.seo.canonical} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <SubpageHero
    heading={page.hero.heading}
    lead={page.hero.lead}
    breadcrumbs={page.breadcrumbs}
    ctaLabel="Pobierz poradnik (PDF)"
    ctaHref="/guides/Przeprowadzka_bez_chaosu.pdf"
    ctaDownload={true}
    note="Darmowy poradnik WHM w formacie PDF."
  />

  <section class="section">
    <div class="container">
      <nav class="anchor-nav" aria-label="Nawigacja poradnika">
        {page.nav.map((item) => (
          <a href={item.href} class="anchor-nav__link">{item.label}</a>
        ))}
      </nav>

      {page.sections.map((section) => (
        <div class="poradnik-section" id={section.id}>
          <h2 class="poradnik-section__heading">{section.heading}</h2>
          {section.intro && <p class="poradnik-section__intro">{section.intro}</p>}
          <ul class="simple-list">
            {section.items.map((item) => (
              <li class="simple-list__item">{item}</li>
            ))}
          </ul>
          {section.image && (
            <div class="poradnik-section__image">
              <img src={section.image} alt={section.imageAlt} width="800" height="600" loading="lazy" decoding="async" />
            </div>
          )}
        </div>
      ))}

      {page.ebookUrl && page.ebookImage ? (
        <div class="poradnik-section" id="ebook">
          <h2 class="poradnik-section__heading">Darmowy e-book</h2>
          <div class="split-section">
            <div class="split-section__media">
              <img src={page.ebookImage} alt={page.ebookImageAlt} width="800" height="600" loading="lazy" decoding="async" />
            </div>
            <div class="split-section__content">
              <p style="font-size: var(--text-sm); color: var(--color-text-secondary); line-height: var(--leading-relaxed); margin-bottom: var(--space-4);">
                Pobierz darmowy e-book WHM z praktycznym poradnikiem przygotowania do przeprowadzki. Format PDF.
              </p>
              <a href={page.ebookUrl} class="btn btn--primary" download>Pobierz e-book (PDF)</a>
            </div>
          </div>
        </div>
      ) : null}

      <div class="section-cta" style="margin-top: var(--space-8);">
        <SectionHeading label="Potrzebujesz pomocy?" title="Przejdź do usług WHM" />
        <div class="standard-links">
          {page.links.map((link) => (
            <a href={link.href} class="arrow-link">{link.label}</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
