---
import Layout from '../../layouts/Layout.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { site } from '../../data/site';
import { realizacjePage as page } from '../../data/services';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: site.domain },
        { '@type': 'ListItem', position: 2, name: 'Realizacje', item: page.seo.canonical },
      ],
    },
  ],
};
---

<Layout title={page.seo.title} description={page.seo.description} robots="index, follow">
  <link slot="head" rel="canonical" href={page.seo.canonical} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <SubpageHero
    heading={page.hero.heading}
    lead={page.hero.lead}
    breadcrumbs={page.breadcrumbs}
    heroImage={page.hero.image}
  />

  <section class="section section--alt">
    <div class="container">
      <SectionHeading label="Kategorie realizacji" title="Różne rodzaje pracy WHM" />
      <div class="realizacje-grid">
        {page.categories.map((cat) => (
          <a href={cat.href} class="realizacje-card">
            <div class="realizacje-card__media">
              <img src={cat.image} alt={cat.alt} width="600" height="450" loading="lazy" decoding="async" />
            </div>
            <div class="realizacje-card__body">
              <p class="realizacje-card__title">{cat.title}</p>
              <p class="realizacje-card__desc">{cat.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container">
      <div class="final-cta__inner">
        <h2 class="final-cta__heading">{page.finalCta.heading}</h2>
        <p class="final-cta__text">{page.finalCta.text}</p>
        <div class="final-cta__actions">
          <a href="/wycena/" class="btn btn--primary btn--lg">Opisz swoją przeprowadzkę</a>
          <a href="/standard-whm/" class="btn btn--secondary btn--lg">Poznaj Standard WHM</a>
        </div>
        <p class="final-cta__hours">Pn–Pt: {site.hours.weekdays} &middot; Sob: {site.hours.saturday}</p>
      </div>
    </div>
  </section>
</Layout>
