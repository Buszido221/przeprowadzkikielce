---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import MobileStickyCta from '../../components/MobileStickyCta.astro';
import { site } from '../../data/site';
import { getRoute } from '../../data/routes';
const route = getRoute('/realizacje/');
const canonical = `${site.domain}realizacje/`;
const cases = [
  {
    label: 'Instytucja publiczna',
    title: 'Prokuratura Kielce-Wschód i Kielce-Zachód',
    text: 'Relokacja objęła cztery piętra i piwnicę, duże archiwum oraz dziesiątki szaf i komputerów. Organizacja kolejności i etapów pozwoliła utrzymać pracę instytucji bez przerwy.',
    image: '/images/institution-moving/przeprowadzki-instytucji-4.webp',
    alt: 'Relokacja wyposażenia instytucji realizowana przez zespół WHM',
    facts: ['4 piętra i piwnica', 'duże archiwum', 'ciągłość działania'],
    href: '/przeprowadzki-firm-i-instytucji/',
  },
  {
    label: 'Dzieło sztuki',
    title: 'Zamek Szydłowieckich',
    text: 'Stary obraz musiał pozostać przez cały czas w pozycji poziomej. Ze względu na warunki obiektu został przeniesiony przez okno zgodnie z przygotowaną drogą transportu.',
    image: '/images/transport-gabarytow/transport-gabarytow-kielce-6.webp',
    alt: 'Zespół WHM podczas wymagającego transportu specjalistycznego',
    facts: ['pozycja pozioma', 'droga przez okno', 'indywidualny plan'],
    href: '/transport-specjalistyczny/',
  },
  {
    label: 'Transport specjalistyczny',
    title: 'Sprzęt, którego nie da się potraktować jak zwykłej paczki',
    text: 'Realizacje WHM obejmowały między innymi szafy serwerowe o wysokości ponad 2 m przenoszone przez okno, piece, serwery, wyposażenie laboratoryjne i liczne pianina.',
    image: '/images/transport-gabarytow/transport-gabarytow-kielce-7.webp',
    alt: 'Przenoszenie dużego przedmiotu z użyciem sprzętu WHM',
    facts: ['szafy serwerowe ponad 2 m', 'piece i laboratoria', 'pianina'],
    href: '/transport-specjalistyczny/',
  },
];
---

<Layout title={route.title} description={route.description} robots={route.robots} canonical={canonical} ogImage="/images/institution-moving/przeprowadzki-instytucji-4.webp">
  <ServiceHero eyebrow="Prawdziwe realizacje WHM" heading="Zakres, ograniczenie i sposób pracy — bez marketingowych skrótów" lead="Pokazujemy własne zdjęcia oraz studia przypadków oparte na potwierdzonych informacjach. Każda realizacja zaczyna się od zrozumienia tego, co w danym zadaniu nie może pójść źle." breadcrumbs={[{ label: route.name }]} heroImage="/images/kielce-moving/przeprowadzki-kielce-5.webp" heroAlt="Zabezpieczone mienie podczas realizacji WHM" secondaryCtaLabel="Poznaj Standard WHM" secondaryCtaHref="/standard-whm/" />

  <section class="section section--alt">
    <div class="container">
      <SectionHeading label="Studia przypadków" title="Trzy różne rodzaje odpowiedzialności" />
      <div class="case-studies">
        {cases.map((item, index) => (
          <article class:list={['case-study', { 'case-study--reverse': index % 2 === 1 }]}>
            <div class="case-study__media"><img src={item.image} alt={item.alt} width="800" height="600" loading="lazy" decoding="async" /></div>
            <div class="case-study__body"><p class="section-heading__label">{item.label}</p><h2>{item.title}</h2><p>{item.text}</p><ul>{item.facts.map((fact) => <li>{fact}</li>)}</ul><a class="arrow-link" href={item.href}>Zobacz właściwą usługę</a></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container"><div class="split-section"><div class="split-section__content"><SectionHeading label="Instytucje kultury" title="Teatr im. Stefana Żeromskiego" description="Teatr im. Stefana Żeromskiego znajduje się wśród instytucji, z którymi współpracował WHM. Nie przypisujemy tej współpracy niepotwierdzonego zakresu — szczegóły prezentujemy wyłącznie wtedy, gdy są zweryfikowane." /></div><div class="split-section__media"><img src="/images/institution-moving/przeprowadzki-instytucji-2.webp" alt="Zespół WHM podczas pracy dla instytucji" width="800" height="600" loading="lazy" decoding="async" class="section-img" /></div></div></div>
  </section>

  <section class="section section--alt"><div class="container"><SectionHeading label="Galeria pracy" title="Zabezpieczenia, sprzęt i prawdziwy zespół" /><div class="photo-grid photo-grid--3"><div class="photo-grid__item"><img src="/images/packing-services/pakowanie-przeprowadzki-kielce-1.webp" alt="Zabezpieczone elementy wyposażenia" width="600" height="450" loading="lazy" decoding="async" /></div><div class="photo-grid__item"><img src="/images/transport-pianin-i-fortepianow/transport-pianin-i-fortepianow-kielce-4.webp" alt="Zabezpieczony instrument podczas transportu WHM" width="600" height="450" loading="lazy" decoding="async" /></div><div class="photo-grid__item"><img src="/images/office-moving/przeprowadzki-biura-2.webp" alt="Zabezpieczone wyposażenie biurowe" width="600" height="450" loading="lazy" decoding="async" /></div></div></div></section>

  <section class="final-cta"><div class="container"><div class="final-cta__inner"><h2 class="final-cta__heading">Masz zadanie, które wymaga własnego planu?</h2><p class="final-cta__text">Opisz zakres i ograniczenia. Najpierw ocenimy sposób realizacji.</p><div class="final-cta__actions"><a href={`tel:${site.phoneRaw}`} class="btn btn--primary btn--lg" data-cta-click data-cta-location="cases-final">Zadzwoń: {site.phone}</a><a href="/wycena/" class="btn btn--secondary btn--lg" data-cta-click data-cta-location="cases-final">Opisz zadanie</a></div></div></div></section>
  <MobileStickyCta formHref="/wycena/" />
</Layout>
