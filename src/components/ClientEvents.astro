<script>
  import { pushMeasurementEvent } from '../lib/measurement';

  if (!document.documentElement.dataset.whmEventsReady) {
    document.documentElement.dataset.whmEventsReady = 'true';

    function locationFor(element: HTMLElement): string {
      if (element.closest('.mobile-sticky-cta')) return 'sticky';
      if (element.closest('.service-hero, .subpage-hero, .hero')) return 'hero';
      if (element.closest('.lead-form')) return 'form';
      if (element.closest('.header-cta, .site-header')) return 'header';
      if (element.closest('.top-bar')) return 'top-bar';
      if (element.closest('.site-footer')) return 'footer';
      if (element.closest('.final-cta')) return 'final';
      return element.dataset.ctaLocation || 'content';
    }

    function destinationFor(link: HTMLAnchorElement | HTMLButtonElement) {
      if (link instanceof HTMLButtonElement) return 'internal_form' as const;
      const href = link.getAttribute('href') || '';
      if (href.startsWith('tel:')) return 'phone' as const;
      if (href.startsWith('sms:')) return 'sms' as const;
      if (href.startsWith('mailto:')) return 'email' as const;
      if (href.includes('whmshop.pl')) return 'external_shop' as const;
      if (href.startsWith('http')) return 'external' as const;
      if (href.includes('#formularz') || href.startsWith('#')) return 'internal_form' as const;
      return 'internal_page' as const;
    }

    function stableCtaId(link: HTMLElement, destination: string, location: string, serviceType: string): string {
      const explicit = link.dataset.ctaId;
      if (explicit) return explicit;
      return [destination, serviceType, location].join('_').toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');
    }

    document.addEventListener('click', function (event) {
      var target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      var link = target.closest<HTMLAnchorElement | HTMLButtonElement>('a, button');
      if (!link) return;

      var eventName: 'phone_click' | 'sms_click' | 'email_click' | 'cta_click' | 'whm_shop_click' | '' = '';
      if (link.matches('a[href^="tel:"]')) {
        eventName = 'phone_click';
      } else if (link.matches('a[href^="sms:"]')) {
        eventName = 'sms_click';
      } else if (link.matches('a[href^="mailto:"]')) {
        eventName = 'email_click';
      } else if (link.matches('a[href*="whmshop.pl"]')) {
        eventName = 'whm_shop_click';
      } else if (link.matches('[data-cta-click]')) {
        eventName = 'cta_click';
      }
      if (!eventName) return;

      var clickLocation = locationFor(link);
      var destination = destinationFor(link);
      var serviceType = link.dataset.serviceType || document.body.dataset.serviceType || 'general';
      var leadContext = link.dataset.leadContext === 'b2b' || document.body.dataset.leadContext === 'b2b' ? 'b2b' : 'b2c';

      pushMeasurementEvent({
        event: eventName,
        interaction_location: clickLocation,
        destination_type: destination,
        cta_id: stableCtaId(link, destination, clickLocation, serviceType),
        service_type: serviceType,
        lead_context: leadContext,
      });
    });
  }
</script>
