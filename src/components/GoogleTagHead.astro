---
import { isStaging } from '../lib/environment';

const GA4_ID = import.meta.env.PUBLIC_GA4_ID ?? '';
const hasGa = GA4_ID && !isStaging;
---

{hasGa && (
  <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`} is:inline></script>
)}
{hasGa && (
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied'
    });
    gtag('js', new Date());
    gtag('config', ${GA4_ID});
    if (localStorage.getItem('whm_cookie_consent') === 'accepted') {
      gtag('consent', 'update', {
        analytics_storage: 'granted'
      });
    }
  </script>
)}
