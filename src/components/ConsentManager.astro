<div id="cookie-consent" class="cookie-consent" role="dialog" aria-modal="true" aria-labelledby="cookie-consent-title" aria-hidden="true">
  <div class="cookie-consent__inner">
    <div class="cookie-consent__text">
      <strong id="cookie-consent-title">Twoje ustawienia prywatności</strong>
      <p>Niezbędne funkcje i formularz działają zawsze. Analitykę oraz pomiar reklam możesz włączyć niezależnie.</p>
      <a href="/polityka-prywatnosci/">Polityka prywatności</a>
    </div>
    <div class="cookie-consent__actions">
      <button id="cookie-reject" class="cookie-consent__btn cookie-consent__btn--secondary" type="button">Tylko niezbędne</button>
      <button id="cookie-settings" class="cookie-consent__btn cookie-consent__btn--secondary" type="button">Ustawienia</button>
      <button id="cookie-accept" class="cookie-consent__btn cookie-consent__btn--primary" type="button">Akceptuję wszystkie</button>
    </div>
  </div>

  <div id="cookie-consent-settings" class="cookie-consent__settings" hidden>
    <label class="cookie-consent__setting">
      <input type="checkbox" id="consent-analytics" />
      <span>Analityka (Google Analytics 4)</span>
    </label>
    <label class="cookie-consent__setting">
      <input type="checkbox" id="consent-ads" />
      <span>Pomiar reklam (Google Ads i Meta Pixel)</span>
    </label>
    <div class="cookie-consent__settings-actions">
      <button id="cookie-settings-save" class="cookie-consent__btn cookie-consent__btn--primary" type="button">Zapisz ustawienia</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var banner = document.getElementById('cookie-consent');
    var settings = document.getElementById('cookie-consent-settings');
    var analytics = document.getElementById('consent-analytics');
    var ads = document.getElementById('consent-ads');
    var api = window.whmConsent;
    if (!banner || !settings || !analytics || !ads || !api) return;

    function show(showSettings) {
      var current = api.get();
      analytics.checked = current ? current.analytics : false;
      ads.checked = current ? current.ads : false;
      settings.hidden = !showSettings;
      banner.setAttribute('aria-hidden', 'false');
      banner.classList.add('cookie-consent--visible');
    }

    function hide() {
      banner.classList.remove('cookie-consent--visible');
      banner.setAttribute('aria-hidden', 'true');
      settings.hidden = true;
    }

    function decide(analyticsValue, adsValue) {
      if (api.save(analyticsValue, adsValue)) hide();
    }

    document.getElementById('cookie-accept').addEventListener('click', function () { decide(true, true); });
    document.getElementById('cookie-reject').addEventListener('click', function () { decide(false, false); });
    document.getElementById('cookie-settings').addEventListener('click', function () { show(true); });
    document.getElementById('cookie-settings-save').addEventListener('click', function () {
      decide(analytics.checked, ads.checked);
    });
    window.addEventListener('whm:open-consent', function () { show(true); });

    if (!api.get()) show(false);
  })();
</script>
